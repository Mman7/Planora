{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Project Planner Cloudflare Worker API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "db:generate": "pnpm --dir ../../packages/database exec drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply ai-project-planner-db --local --force --config wrangler.jsonc",
    "db:seed": "node scripts/seed.mjs",
    "db:studio": "pnpm --dir ../../packages/database exec drizzle-kit studio --config drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.167.0"
  }
}

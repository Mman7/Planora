{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-project-planner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-project-planner-db",
      "migrations_dir": "../../packages/database/drizzle/migrations",
    },
  ],
  "dev": {
    "port": 8787,
    "local_protocol": "http",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
}
